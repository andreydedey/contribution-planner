{
  "testCommand": "cd client && bunx vitest run --reporter=json --outputFile=../.spec/verification/vitest.json",
  "reporter": "vitest-json",
  "reporterOutputFile": ".spec/verification/vitest.json",
  "testGlobs": [
    "client/src/**/*.test.*",
    "client/src/**/__tests__/**",
    "server/src/test/**"
  ],
  "srcGlobs": [
    "client/src/**",
    "server/src/main/**"
  ]
}
